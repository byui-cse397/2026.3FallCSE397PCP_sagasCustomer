#!/usr/bin/env bash
#
# Stops the one mistake that breaks CI before a single check runs.
#
# CI installs with CI=true, which makes `pnpm install` behave as
# --frozen-lockfile. If a dependency changed and pnpm-lock.yaml did not, the
# install fails at the setup step in about thirteen seconds and nothing
# downstream runs. It looks fine locally, because your node_modules is already
# correct.
#
# This has happened to us. That is why the hook exists.
#
# It only complains when the dependency maps actually changed. Renaming a
# script or editing a description is not a dependency change and will not stop
# you. A hook that cries wolf gets bypassed on reflex, and then it is not
# protecting anything.
#
# Enabled automatically by `pnpm install`, via the `prepare` script in the root
# package.json. No dependency, nothing to remember.
#
# To skip it:  git commit --no-verify

set -uo pipefail

staged() { git diff --cached --name-only --diff-filter=ACM; }

PACKAGE_JSONS=$(staged | grep -E '(^|/)package\.json$' || true)
LOCKFILE=$(staged | grep -E '^pnpm-lock\.yaml$' || true)

[ -z "$PACKAGE_JSONS" ] && exit 0
[ -n "$LOCKFILE" ] && exit 0

# Compare only the dependency maps, before and after. Falls back to flagging
# any package.json change if node is not on PATH — some GUI git clients do not
# inherit a version manager's shell setup.
deps_changed() {
  local file="$1" before after
  before=$(git show "HEAD:$file" 2>/dev/null || echo '{}')
  after=$(git show ":$file" 2>/dev/null || echo '{}')

  command -v node >/dev/null 2>&1 || return 0

  node -e '
    const keys = ["dependencies","devDependencies","peerDependencies","optionalDependencies","pnpm"];
    const read = (s) => { try { return JSON.parse(s); } catch { return {}; } };
    const shape = (o) => JSON.stringify(keys.map((k) => o[k] ?? {}));
    process.exit(shape(read(process.argv[1])) === shape(read(process.argv[2])) ? 1 : 0);
  ' "$before" "$after"
}

MOVED=""
for f in $PACKAGE_JSONS; do
  if deps_changed "$f"; then
    MOVED="$MOVED$f"$'\n'
  fi
done

[ -z "$MOVED" ] && exit 0

echo "✗ A dependency changed but pnpm-lock.yaml is not staged."
echo
echo "  Changed:"
printf '%s' "$MOVED" | sed 's/^/    /'
echo
echo "  CI installs with --frozen-lockfile and will fail before running anything."
echo
echo "      pnpm install"
echo "      git add pnpm-lock.yaml"
echo
echo "  To commit anyway:  git commit --no-verify"
echo
exit 1
